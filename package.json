{
  "name": "shu-reader",
  "version": "1.6.0",
  "description": "墨域 InkRealm - 桌面阅读器，支持全屏 / 窗口 / 墨域三种模式",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "dev": "node launch.js --dev",
    "build": "node tools/build.js full",
    "build:full": "node tools/build.js full",
    "build:lite": "node tools/build.js lite",
    "build:dir": "electron-builder --win --x64 --dir",
    "build:launcher": "tools\\launcher\\build-launcher.bat"
  },
  "author": "shu-reader",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.doosho.shureader",
    "productName": "墨域",
    "copyright": "Copyright © 2024 shu-reader",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "launch.js",
      "lib/**/*",
      "src/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json",
      "!ShuReader.exe",
      "!tools/**/*",
      "!scripts/**/*",
      "!start.bat"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "InkRealm-Setup-${version}-Full-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "displayLanguageSelector": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "墨域",
      "uninstallDisplayName": "墨域",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": "墨域",
      "include": "build/installer.nsh",
      "warningsAsErrors": false
    },
    "squirrelWindows": null,
    "publish": {
      "provider": "github",
      "owner": "masterball-w",
      "repo": "txt_book_reader",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@lingo-reader/epub-parser": "^0.4.6",
    "@lingo-reader/mobi-parser": "^0.4.6",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1"
  }
}
